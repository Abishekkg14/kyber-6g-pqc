n=middle;spacing=0;fontFamily=Arial;fontSize=9.33;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="358" y="47" width="108" height="12" as="geometry"/></mxCell><mxCell id="txt13" value="what moved" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=9.33;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="480" y="47" width="108" height="12" as="geometry"/></mxCell><mxCell id="txt21" value="tiles of the two looks are correlated:&lt;br&gt;shift, turn and zoom of the camera" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=9.33;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="24" y="122" width="204" height="26" as="geometry"/></mxCell><mxCell id="txt22" value="&lt;i&gt;every edge of the&lt;br&gt;scene differs&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=9.33;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="234" y="122" width="112" height="26" as="geometry"/></mxCell><mxCell id="txt24" value="previous look put&lt;br&gt;onto this one" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=9.33;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="370" y="122" width="112" height="26" as="geometry"/></mxCell><mxCell id="txt26" value="above the noise,&lt;br&gt;twice in a row" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=9.33;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="492" y="122" width="108" height="26" as="geometry"/></mxCell><mxCell id="txt28" value="&lt;b&gt;Report&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=9.33;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="box27"><mxGeometry x="0" y="4" width="106" height="13" as="geometry"/></mxCell><mxCell id="txt29" value="where, how strong,&lt;br&gt;since when: a few&lt;br&gt;hundred bytes of text" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=9.33;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="box27"><mxGeometry x="2" y="19" width="102" height="36" as="geometry"/></mxCell><mxCell id="txt36" value="&lt;i&gt;status stream of the link&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=9.33;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="600" y="177" width="118" height="12" as="geometry"/></mxCell><mxCell id="txt38" value="Ground station: dashed boxes&lt;br&gt;on the live view, event log" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=9.33;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="34" y="160" width="150" height="24" as="geometry"/></mxCell><mxCell id="txt40" value="PHOTO ON MOTION: a sealed&lt;br&gt;photo when movement begins" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=9.33;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="230" y="160" width="150" height="24" as="geometry"/></mxCell><mxCell id="txt42" value="SENTRY: the camera watches,&lt;br&gt;no video is sent, only the reports" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=9.33;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="426" y="160" width="170" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
