ometry"/></mxCell><mxCell id="txt23" value="&lt;b&gt;Tampering&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.33px&quot;&gt;modify, inject&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=10.67;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="29" y="180" width="104" height="26" as="geometry"/></mxCell><mxCell id="txt27" value="&lt;b&gt;Downgrade&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.33px&quot;&gt;weaker algorithm suite&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=10.67;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="29" y="210" width="104" height="26" as="geometry"/></mxCell><mxCell id="txt31" value="&lt;b&gt;Key compromise&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.33px&quot;&gt;past and future traffic&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=10.67;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="29" y="240" width="104" height="26" as="geometry"/></mxCell><mxCell id="txt35" value="&lt;b&gt;Seized UAV&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.33px&quot;&gt;stored photos, video&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=10.67;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="29" y="270" width="104" height="26" as="geometry"/></mxCell><mxCell id="txt39" value="&lt;b&gt;Forged file&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.33px&quot;&gt;planted recording&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=10.67;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="29" y="300" width="104" height="26" as