eight="12" as="geometry"/></mxCell><mxCell id="txt5" value="&lt;b&gt;Reassembly&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=10.67;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="42" y="43" width="272" height="13" as="geometry"/></mxCell><mxCell id="txt6" value="&lt;i&gt;128 partial messages; a full table drops its oldest&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=9.33;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="42" y="56" width="272" height="12" as="geometry"/></mxCell><mxCell id="txt10" value="&lt;b&gt;The same hello within 10 s?&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=10.67;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="42" y="83" width="272" height="13" as="geometry"/></mxCell><mxCell id="txt11" value="&lt;i&gt;yes: the stored answer is sent again&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=9.33;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="42" y="96" width="272" height="12" as="geometry"/></mxCell><mxCell id="txt15" value="&lt;b&gt;Ration left?&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=10.67;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="42" y="123" width="272" height="13" as="geometry"/></mxCell><mxCell id="txt16" value="&lt;i&gt;a quarter of one core for failed checks; empty: dropped&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=9.33;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="42" y="136" width="272" height="12" as="geometry"/></mxCell><mxCell id="txt20" value="&lt;b&gt;UAV known, nonce new, time within 120 s?&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=10.67;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="42" y="163" width="272" height="13" as="geometry"/></mxCell><mxCell id="txt21" value="&lt;i&gt;no: refused, at no cost&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=9.33;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="42" y="176" width="272" height="12" as="geometry"/></mxCell><mxCell id="txt25" value="&lt;i&gt;fails: refused, and one unit of the ration is used&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=9.33;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="42" y="216" width="272" height="12" as="geometry"/></mxCell><mxCell id="txt29" value="&lt;i&gt;encapsulate, derive, sign; 64 half-open sessions at most&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=9.33;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="42" y="262" width="272" height="12" as="geometry"/></mxCell><mxCell id="txt33" value="verify (pinned key): 0.08 ms, 0.45 ms on a Pi" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=9.33;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="110.8" y="201" width="200" height="16" as="geometry"/></mxCell><mxCell id="txt37" value="&lt;b&gt;ServerHello&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=10.67;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="240.2" y="247" width="70" height="16" as="geometry"/></mxCell><mxCell id="txt39" value="without public-key work" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=9.33;fontColor=#1A1A1A;fontStyle=0;horizontal=0;" vertex="1" parent="1"><mxGeometry x="323" y="44" width="13" height="144" as="geometry"/></mxCell><mxCell id="txt41" value="public-key work" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=9.33;fontColor=#1A1A1A;fontStyle=0;horizontal=0;" vertex="1" parent="1"><mxGeometry x="323" y="200" width="13" height="74" as="geometry"/></mxCell><mxCell id="txt42" value="&lt;i&gt;a genuine hello never uses the ration: only checks that fail do&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=9.33;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2" y="287" width="336.16" height="13" as="geometry"/></mxCell><mxCell id="edge38" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=14;html=1;strokeColor=#767676;strokeWidth=1.0;endArrow=none;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320" y="44" as="sourcePoint"/><mxPoint x="320" y="188" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge40" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=14;html=1;strokeColor=#767676;strokeWidth=1.0;endArrow=none;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320" y="200" as="sourcePoint"/><mxPoint x="320" y="274" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
