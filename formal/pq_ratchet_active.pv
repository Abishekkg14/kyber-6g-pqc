(* Kyber-6G PQ ratchet, the limit of its healing: the OLD master secret is given to the attacker at the start and he
   is ACTIVE on the network during the ratchet. He can then open and make the two control messages himself and play
   the ground station towards the UAV. Every query below must come out FALSE.

   (One run of the UAV is enough to show it, and the ground station is not needed at all: the attacker stands in
   for it. With both ends present and the secret known ProVerif does not come to an end. The attacker who only
   listens is in pq_ratchet_passive.pv: there the session heals.) *)

const sid0: bitstring.
free secretU2: bitstring [private].

event UavRatcheted(bitstring, bitstring, key).
event GcsRatcheted(bitstring, bitstring, key).

query attacker(secretU2).                                                                      (* must be FALSE *)
query s: bitstring, k: key; event(UavRatcheted(sid0, s, k)) ==> event(GcsRatcheted(sid0, s, k)).   (* must be FALSE *)

let UAV(m0: key) =
  new x: scalar; new dk: kemsk; new rid: bitstring; new n1: bitstring;
  let ku = hkdf_expand(m0, (L_CONTROL, DIR_U2G, suite, sid0)) in
  let kg = hkdf_expand(m0, (L_CONTROL, DIR_G2U, suite, sid0)) in
  out(c, (n1, aead(ku, n1, (RATCHET_REQ, rid, exp(g, x), kempub(dk)), sid0)));
  in(c, (n2: bitstring, e: bitstring));
  let (=RATCHET_RESP, =rid, Xs: point, ct: bitstring, sid1: bitstring) = aead_open(kg, n2, e, sid0) in
  let th = h((LBL_PQR, sid0, rid, exp(g, x), kempub(dk), Xs, ct, sid1)) in
  let m1 = hkdf_expand(hkdf_extract(th, (decap(ct, dk), exp(Xs, x), m0)), (L_MASTER, suite, sid1)) in
  event UavRatcheted(sid0, sid1, m1);
  out(c, aead(hkdf_expand(m1, (L_TRAFFIC, DIR_U2G, suite, sid1)), n0, secretU2, empty)).

process
  new m0: key;
  out(c, m0);
  UAV(m0)
